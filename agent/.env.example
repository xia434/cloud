# ============================================================
# 环境变量配置模板（复制为 .env 后填入真实值）
# 警告：.env 包含敏感信息，已加入 .gitignore，切勿上传到 GitHub
# ============================================================

# LLM 配置
MODEL=qwen-plus
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MCP 配置（可选，默认用当前 Python 解释器）
PYTHON_EXEC=

# Redis（短期记忆）
REDIS_URL=redis://:your_redis_password@localhost:6380
REDIS_TTL=1800

# Milvus（长期记忆）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_API_KEY=

# Neo4j（知识图谱）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# MySQL（MCP Server 依赖）
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=cloud_platform

# JWT 认证
JWT_SECRET=your_jwt_secret_at_least_16_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Langfuse 可观测性（可选）
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_HOST=http://localhost:3000

# 天气 API（可选，用于 chitchat agent 演示）
OPENWEATHER_API_KEY=
# Official Ragas offline evaluation (optional overrides)
RAGAS_MODEL=qwen-plus
RAGAS_MAX_WORKERS=4
RAGAS_TIMEOUT_SECONDS=180
RAGAS_MIN_FAITHFULNESS=0.75
RAGAS_MIN_ANSWER_RELEVANCY=0.70
RAGAS_MIN_CONTEXT_PRECISION=0.65
RAGAS_MIN_CONTEXT_RECALL=0.60

# RAG 两阶段检索：Milvus 召回候选，再由本地轻量重排器保留最终上下文
RAG_RETRIEVAL_CANDIDATES=8
RAG_RETRIEVAL_TOP_K=3
